# 复制为 backend/.env 后填入真实值
DIFY_BASE_URL=http://47.114.83.33/v1

DIFY_APP1_KEY=app-你的应用1密钥
DIFY_APP2_KEY=app-你的应用2密钥

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
MAX_ROWS=200000

MAX_QUERY_LIMIT=500
DEFAULT_QUERY_LIMIT=50
MAX_PREVIEW_ROWS=100
MAX_RESULT_ROWS_FOR_LLM=200
MAX_SESSIONS=100

DIFY_TIMEOUT_SECONDS=180

# 给应用1 的追问上下文（只约束历史轮次，当前问题总是完整发送）
APP1_CONTEXT_MAX_CHARS=1500
APP1_CONTEXT_QUESTION_CHARS=300

# 认证：令牌签名密钥（生成方式：python -c "import secrets;print(secrets.token_hex(32))"）
AUTH_SECRET=请替换为随机字符串
AUTH_ACCESS_TTL_SECONDS=1800
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_PASSWORD_MIN=8
AUTH_PASSWORD_MAX=64
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_IP_MAX_FAILURES=20
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCK_SECONDS=900

DB_PATH=data/app.db

HISTORY_PAGE_SIZE=20
HISTORY_MAX_PAGE_SIZE=100
HISTORY_TURNS_FOR_CONTEXT=50
